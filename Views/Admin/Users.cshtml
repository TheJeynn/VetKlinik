@using VetKlinik.Controllers
@model List<UserRow>
@{
    ViewData["Title"] = "Kullanıcılar";
    var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<h2 class="page-title mb-3"><i class="bi bi-people"></i> Kullanıcılar</h2>
<div class="card shadow-sm"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th>Rolü Değiştir</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td><td>@u.Email</td>
            <td><span class="badge bg-@(u.Role == "Admin" ? "danger" : u.Role == "Veteriner" ? "info" : "secondary")">@u.Role</span></td>
            <td>
                <form asp-action="SetRole" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@u.Id" />
                    <select name="role" class="form-select form-select-sm" style="width:140px" disabled="@(u.Id == me)">
                        @foreach (var r in new[] { "Uye", "Veteriner", "Admin" }) { <option value="@r" selected="@(r == u.Role)">@r</option> }
                    </select>
                    <button class="btn btn-sm btn-success" disabled="@(u.Id == me)">Kaydet</button>
                </form>
            </td>
            <td class="text-end">
                @if (u.Id != me)
                {
                    <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Kullanıcı ve hayvanları silinsin mi?')"><input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
                }
            </td>
        </tr>
    }
    </tbody>
</table></div></div>