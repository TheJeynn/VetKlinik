@model VetKlinik.Models.Vaccination

@{
    ViewData["Title"] = "Create";
}

<h2 class="page-title">Yeni Kayıt</h2>

<h4>Aşı</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PetId" class="control-label"></label>
                <select asp-for="PetId" class="form-select" asp-items="ViewBag.PetId"><option value="">-- Seçiniz --</option></select>
            </div>
            <div class="form-group">
                <label asp-for="VaccineName" class="control-label"></label>
                <input asp-for="VaccineName" class="form-control" />
                <span asp-validation-for="VaccineName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateGiven" class="control-label"></label>
                <input asp-for="DateGiven" class="form-control" />
                <span asp-validation-for="DateGiven" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NextDoseDate" class="control-label"></label>
                <input asp-for="NextDoseDate" class="form-control" />
                <span asp-validation-for="NextDoseDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Listeye Dön</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
