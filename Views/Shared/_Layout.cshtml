<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetKlinik</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VetKlinik.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark vet-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🐾 VetKlinik</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Ana Sayfa</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Clinics" asp-action="Index"><i class="bi bi-hospital"></i> Klinikler</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ClinicServices" asp-action="Index"><i class="bi bi-bandaid"></i> Hizmetler</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vets" asp-action="Index"><i class="bi bi-person-badge"></i> Veterinerler</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Pets" asp-action="Index"><i class="bi bi-heart-fill"></i> Hayvanlar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vaccinations" asp-action="Index"><i class="bi bi-shield-check"></i> Aşılar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Randevular</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear"></i> Yönetim</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Panel</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Kullanıcılar</a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>
<main class="container flex-grow-1 py-4">
    @if (TempData["Ok"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<footer class="site-footer py-3 text-center text-muted small">&copy; @DateTime.Now.Year VetKlinik - Veteriner Randevu ve Hasta Takip Sistemi</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>